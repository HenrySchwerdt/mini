# The official LLVM 18 Windows package embeds its build machine's VS2019
# diaguids.lib path in imported link interfaces. Use the installed x64 DIA GUID
# archive instead; all other LLVM dependencies remain intact.
if(NOT WIN32)
    return()
endif()

foreach(component IN LISTS LLVM_AVAILABLE_LIBS)
    if(NOT TARGET ${component})
        continue()
    endif()
    get_target_property(is_imported ${component} IMPORTED)
    if(NOT is_imported)
        continue()
    endif()
    get_target_property(link_items ${component} INTERFACE_LINK_LIBRARIES)
    if(NOT link_items)
        continue()
    endif()
    set(relocated_items)
    foreach(item IN LISTS link_items)
        string(REPLACE "\\" "/" candidate "${item}")
        set(link_only FALSE)
        if(candidate MATCHES "^[$]<LINK_ONLY:(.*)>$")
            set(candidate "${CMAKE_MATCH_1}")
            set(link_only TRUE)
        endif()
        get_filename_component(basename "${candidate}" NAME)
        string(TOLOWER "${basename}" basename)
        if(basename STREQUAL "diaguids.lib" AND IS_ABSOLUTE "${candidate}" AND NOT EXISTS "${candidate}")
            if("$ENV{VSINSTALLDIR}" STREQUAL "")
                message(FATAL_ERROR "VSINSTALLDIR is missing; initialize the VS x64 developer environment")
            endif()
            find_library(MINI_DIA_GUIDS NAMES diaguids
                PATHS "$ENV{VSINSTALLDIR}/DIA SDK/lib/amd64" NO_DEFAULT_PATH REQUIRED)
            message(STATUS "Relocating ${component} DIA GUID archive to ${MINI_DIA_GUIDS}")
            if(link_only)
                list(APPEND relocated_items "$<LINK_ONLY:${MINI_DIA_GUIDS}>")
            else()
                list(APPEND relocated_items "${MINI_DIA_GUIDS}")
            endif()
        else()
            list(APPEND relocated_items "${item}")
        endif()
    endforeach()
    set_property(TARGET ${component} PROPERTY INTERFACE_LINK_LIBRARIES "${relocated_items}")
endforeach()
