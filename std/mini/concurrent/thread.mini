package mini.concurrent

public enum ConcurrencyErrorKind { OutOfMemory, AlreadyStarted, NotStarted, Closed, Busy, System }

public class ConcurrencyError {
    public val kind: ConcurrencyErrorKind
    public val code: i32

    public static native(code: i32): ConcurrencyError {
        if code == runtime.uvOutOfMemory() {
            return ConcurrencyError { kind: ConcurrencyErrorKind.OutOfMemory, code: code }
        }
        if code == runtime.uvBusy() {
            return ConcurrencyError { kind: ConcurrencyErrorKind.Busy, code: code }
        }
        return ConcurrencyError { kind: ConcurrencyErrorKind.System, code: code }
    }

    public static state(kind: ConcurrencyErrorKind): ConcurrencyError = ConcurrencyError { kind: kind, code: 0 }
}

private enum ThreadState { New, Started, Joined, Closed }

// Single owner. The runtime copies the task before starting; borrowed captures
// must remain valid until join/close completes. Do not copy a started Thread.
public class Thread {
    private val block: () -> void
    private var handle: Optional<*u8>
    private var state: ThreadState

    public static create(block: () -> void): Thread = Thread {
        block: block,
        handle: Optional.None,
        state: ThreadState.New,
    }

    private started(handle: *u8): Result<bool, ConcurrencyError> {
        this.handle = Optional.Some(handle)
        this.state = ThreadState.Started
        return Result.Ok(true)
    }

    public start(): Result<bool, ConcurrencyError> {
        if this.state == ThreadState.Closed { return Result.Err(ConcurrencyError.state(ConcurrencyErrorKind.Closed)) }
        if this.state != ThreadState.New { return Result.Err(ConcurrencyError.state(ConcurrencyErrorKind.AlreadyStarted)) }
        var code: i32 = 0
        return match runtime.threadStart(this.block, &code) {
            Some(handle) => this.started(handle)
            None => Result.Err(ConcurrencyError.native(code))
        }
    }

    private joinHandle(handle: *u8): Result<bool, ConcurrencyError> {
        val code = runtime.threadJoin(handle)
        if code != 0 { return Result.Err(ConcurrencyError.native(code)) }
        this.handle = Optional.None
        this.state = ThreadState.Joined
        return Result.Ok(true)
    }

    public join(): Result<bool, ConcurrencyError> {
        if this.state == ThreadState.New { return Result.Err(ConcurrencyError.state(ConcurrencyErrorKind.NotStarted)) }
        if this.state == ThreadState.Closed { return Result.Err(ConcurrencyError.state(ConcurrencyErrorKind.Closed)) }
        if this.state == ThreadState.Joined { return Result.Ok(false) }
        return match this.handle {
            Some(handle) => this.joinHandle(handle)
            None => Result.Err(ConcurrencyError.state(ConcurrencyErrorKind.System))
        }
    }

    public isAlive(): bool {
        return match this.handle {
            Some(handle) => runtime.threadIsAlive(handle)
            None => false
        }
    }

    private finishClose(changed: bool): Result<bool, ConcurrencyError> {
        this.state = ThreadState.Closed
        return Result.Ok(changed)
    }

    // Joins a running task. A failure preserves the handle for a retry.
    public close(): Result<bool, ConcurrencyError> {
        if this.state == ThreadState.Closed { return Result.Ok(false) }
        if this.state == ThreadState.New { return this.finishClose(false) }
        return match this.join() {
            Ok(changed) => this.finishClose(changed)
            Err(error) => Result.Err(error)
        }
    }

    public static sleep(milliseconds: usize): void = runtime.threadSleep(milliseconds)
}

// Class-scoped counterpart of kotlin.concurrent.thread, starting immediately.
public class Threads {
    public static thread(block: () -> void): Result<Thread, ConcurrencyError> {
        val thread = Thread.create(block)
        return match thread.start() {
            Ok(changed) => Result.Ok(thread)
            Err(error) => Result.Err(error)
        }
    }
}
