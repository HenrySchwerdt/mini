package mini.net

public enum NetErrorKind { OutOfMemory, Refused, Reset, Closed, System }

public class NetError {
    public val kind: NetErrorKind
    public val code: i32

    public static native(code: i32): NetError {
        if code == runtime.uvOutOfMemory() {
            return NetError { kind: NetErrorKind.OutOfMemory, code: code }
        }
        if code == runtime.uvRefused() {
            return NetError { kind: NetErrorKind.Refused, code: code }
        }
        if code == runtime.uvReset() {
            return NetError { kind: NetErrorKind.Reset, code: code }
        }
        return NetError { kind: NetErrorKind.System, code: code }
    }

    public static state(kind: NetErrorKind): NetError = NetError { kind: kind, code: 0 }
}

// Blocking transfer helper shared by connections: negative counts are libuv codes.
public class NetCount {
    public static result(count: isize): Result<usize, NetError> {
        if count < cast<isize>(0) {
            return Result.Err(NetError.native(cast<i32>(count)))
        }
        return Result.Ok(cast<usize>(count))
    }
}

// Single owner, blocking. Do not use one connection from two threads at once.
public class TcpConnection {
    private var handle: Optional<*u8>

    private static opened(handle: *u8): Result<TcpConnection, NetError> = Result.Ok(TcpConnection { handle: Optional.Some(handle) })

    public static connect(host: *u8, port: i32): Result<TcpConnection, NetError> {
        var code: i32 = 0
        return match runtime.tcpConnect(host, port, &code) {
            Some(handle) => TcpConnection.opened(handle)
            None => Result.Err(NetError.native(code))
        }
    }

    // Immutable string literals cannot cross a mutable *u8 parameter, so the loopback
    // convenience passes its literal straight to the intrinsic.
    public static connectLoopback(port: i32): Result<TcpConnection, NetError> {
        var code: i32 = 0
        return match runtime.tcpConnect("127.0.0.1", port, &code) {
            Some(handle) => TcpConnection.opened(handle)
            None => Result.Err(NetError.native(code))
        }
    }

    // Used by TcpListener.accept.
    public static adopt(handle: *u8): Result<TcpConnection, NetError> = TcpConnection.opened(handle)

    public write(data: *u8, len: usize): Result<usize, NetError> {
        return match this.handle {
            Some(handle) => NetCount.result(runtime.tcpWrite(handle, data, len))
            None => Result.Err(NetError.state(NetErrorKind.Closed))
        }
    }

    public read(buf: *u8, cap: usize): Result<usize, NetError> {
        return match this.handle {
            Some(handle) => NetCount.result(runtime.tcpRead(handle, buf, cap))
            None => Result.Err(NetError.state(NetErrorKind.Closed))
        }
    }

    private finishClose(handle: *u8): Result<bool, NetError> {
        runtime.tcpClose(handle)
        this.handle = Optional.None
        return Result.Ok(true)
    }

    public close(): Result<bool, NetError> {
        return match this.handle {
            Some(handle) => this.finishClose(handle)
            None => Result.Ok(false)
        }
    }
}

// Listens on 127.0.0.1. Close accepted connections before the listener.
public class TcpListener {
    private var handle: Optional<*u8>

    private static opened(handle: *u8): Result<TcpListener, NetError> = Result.Ok(TcpListener { handle: Optional.Some(handle) })

    public static bind(port: i32): Result<TcpListener, NetError> {
        var code: i32 = 0
        return match runtime.tcpListen(port, &code) {
            Some(handle) => TcpListener.opened(handle)
            None => Result.Err(NetError.native(code))
        }
    }

    private acceptFrom(handle: *u8): Result<TcpConnection, NetError> {
        var code: i32 = 0
        return match runtime.tcpAccept(handle, &code) {
            Some(connection) => TcpConnection.adopt(connection)
            None => Result.Err(NetError.native(code))
        }
    }

    public accept(): Result<TcpConnection, NetError> {
        return match this.handle {
            Some(handle) => this.acceptFrom(handle)
            None => Result.Err(NetError.state(NetErrorKind.Closed))
        }
    }

    private finishClose(handle: *u8): Result<bool, NetError> {
        runtime.tcpListenerClose(handle)
        this.handle = Optional.None
        return Result.Ok(true)
    }

    public close(): Result<bool, NetError> {
        return match this.handle {
            Some(handle) => this.finishClose(handle)
            None => Result.Ok(false)
        }
    }
}
