package mini.collections

public class IndexError {
    public val index: usize
    public val size: usize
}

public enum CollectionError { OutOfMemory, CapacityOverflow }

public interface RandomAccess {}

public interface Collection<T> {
    size(): usize
    isEmpty(): bool = this.size() == cast<usize>(0)
}

public interface MutableCollection<T> : Collection<T> {
    add(element: T): Result<bool, CollectionError>
    clear()
}

public interface List<T> : Collection<T> {
    get(index: usize): Result<T, IndexError>
}

public interface MutableList<T> : List<T>, MutableCollection<T> {
    set(index: usize, element: T): Result<T, IndexError>
    removeAt(index: usize): Result<T, IndexError>
}
