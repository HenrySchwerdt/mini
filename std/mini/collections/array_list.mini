package mini.collections

import mini.memory.Allocator
import mini.memory.AllocationError

private enum ResizeStatus { Ready, OutOfMemory, CapacityOverflow }

// Owns its backing buffer. Keep one owning value; pass borrowed pointers/views.
// Elements are copied and have no automatic destructor. Allocator views are borrowed.
public class ArrayList<T> : AllocatableObject, MutableList<T>, RandomAccess {
    private var buffer: Optional<*T>
    private var count: usize
    private var capacity: usize
    private val allocator: Optional<*Allocator>

    public static create(): ArrayList<T> = ArrayList<T> {
        buffer: Optional.None,
        count: 0,
        capacity: 0,
        allocator: Optional.None,
    }

    public static withAllocator(allocator: *Allocator): ArrayList<T> = ArrayList<T> {
        buffer: Optional.None,
        count: 0,
        capacity: 0,
        allocator: Optional.Some(allocator),
    }

    private allocateHeap(bytes: usize): Result<*u8, AllocationError> {
        return match heap.alloc(bytes) {
            Some(memory) => Result.Ok(memory)
            None => Result.Err(AllocationError.OutOfMemory)
        }
    }

    private allocateBytes(bytes: usize): Result<*u8, AllocationError> {
        return match this.allocator {
            Some(allocator) => allocator.allocate(bytes)
            None => this.allocateHeap(bytes)
        }
    }

    private release(memory: *T): void {
        match this.allocator {
            Some(allocator) => allocator.release(cast<*u8>(memory))
            None => heap.free(cast<*u8>(memory))
        }
    }

    private noBuffer(): void {}

    private releaseBuffer(): void {
        match this.buffer {
            Some(memory) => this.release(memory)
            None => this.noBuffer()
        }
    }

    private copyElements(source: *T, destination: *T): void {
        var index: usize = 0
        while index < this.count {
            destination[index] = source[index]
            index = index + cast<usize>(1)
        }
    }

    private install(raw: *u8, capacity: usize): ResizeStatus {
        val replacement = cast<*T>(raw)
        match this.buffer {
            Some(previous) => this.copyElements(previous, replacement)
            None => this.noBuffer()
        }
        this.releaseBuffer()
        this.buffer = Optional.Some(replacement)
        this.capacity = capacity
        return ResizeStatus.Ready
    }

    private reserve(minimum: usize): ResizeStatus {
        if minimum <= this.capacity { return ResizeStatus.Ready }
        val maximum = (cast<usize>(0) - cast<usize>(1)) / sizeof(T)
        if minimum > maximum { return ResizeStatus.CapacityOverflow }
        var next: usize = 4
        if this.capacity > cast<usize>(0) { next = this.capacity }
        if next > maximum { next = minimum }
        while next < minimum {
            if next > maximum / cast<usize>(2) { next = minimum }
            else { next = next * cast<usize>(2) }
        }
        return match this.allocateBytes(next * sizeof(T)) {
            Ok(memory) => this.install(memory, next)
            Err(error) => ResizeStatus.OutOfMemory
        }
    }

    public ensureCapacity(minCapacity: usize): Result<bool, CollectionError> {
        val previous = this.capacity
        return match this.reserve(minCapacity) {
            ResizeStatus.Ready => Result.Ok(this.capacity != previous)
            ResizeStatus.OutOfMemory => Result.Err(CollectionError.OutOfMemory)
            ResizeStatus.CapacityOverflow => Result.Err(CollectionError.CapacityOverflow)
        }
    }

    public override size(): usize = this.count

    private missing(index: usize): IndexError = IndexError { index: index, size: this.count }

    public override get(index: usize): Result<T, IndexError> {
        if index >= this.count { return Result.Err(this.missing(index)) }
        return match this.buffer {
            Some(memory) => Result.Ok(memory[index])
            None => Result.Err(this.missing(index))
        }
    }

    private replace(memory: *T, index: usize, element: T): Result<T, IndexError> {
        val previous = memory[index]
        memory[index] = element
        return Result.Ok(previous)
    }

    public override set(index: usize, element: T): Result<T, IndexError> {
        if index >= this.count { return Result.Err(this.missing(index)) }
        return match this.buffer {
            Some(memory) => this.replace(memory, index, element)
            None => Result.Err(this.missing(index))
        }
    }

    private append(memory: *T, element: T): Result<bool, CollectionError> {
        memory[this.count] = element
        this.count = this.count + cast<usize>(1)
        return Result.Ok(true)
    }

    public override add(element: T): Result<bool, CollectionError> {
        val maximum = cast<usize>(0) - cast<usize>(1)
        if this.count == maximum { return Result.Err(CollectionError.CapacityOverflow) }
        val status = this.reserve(this.count + cast<usize>(1))
        if status == ResizeStatus.OutOfMemory { return Result.Err(CollectionError.OutOfMemory) }
        if status == ResizeStatus.CapacityOverflow { return Result.Err(CollectionError.CapacityOverflow) }
        return match this.buffer {
            Some(memory) => this.append(memory, element)
            None => Result.Err(CollectionError.OutOfMemory)
        }
    }

    private remove(memory: *T, index: usize): Result<T, IndexError> {
        val previous = memory[index]
        var position = index
        while position + cast<usize>(1) < this.count {
            memory[position] = memory[position + cast<usize>(1)]
            position = position + cast<usize>(1)
        }
        this.count = this.count - cast<usize>(1)
        return Result.Ok(previous)
    }

    public override removeAt(index: usize): Result<T, IndexError> {
        if index >= this.count { return Result.Err(this.missing(index)) }
        return match this.buffer {
            Some(memory) => this.remove(memory, index)
            None => Result.Err(this.missing(index))
        }
    }

    public override clear(): void { this.count = cast<usize>(0) }

    // Idempotent; releases capacity and leaves an empty, reusable list.
    public close(): void {
        val previous = this.buffer
        this.buffer = Optional.None
        this.count = cast<usize>(0)
        this.capacity = cast<usize>(0)
        match previous {
            Some(memory) => this.release(memory)
            None => this.noBuffer()
        }
    }
}
