package mini.core

public class Pair<A, B> {
    public val first: A
    public val second: B

    public static of(a: A, b: B): Pair<A, B> = Pair<A, B> { first: a, second: b }
}

public class Triple<A, B, C> {
    public val first: A
    public val second: B
    public val third: C

    public static of(a: A, b: B, c: C): Triple<A, B, C> = Triple<A, B, C> { first: a, second: b, third: c }
}
