package mini.core

// Class-scoped counterparts of Kotlin's top-level helpers.
public class Functions {
    public static run<R>(block: () -> R): R = block()

    public static repeat(times: usize, action: (usize) -> void): void {
        var index: usize = 0
        while index < times {
            action(index)
            index = index + cast<usize>(1)
        }
    }
}
