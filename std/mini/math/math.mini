package mini.math

// Pure integer arithmetic helpers.
public class Math {
    public static abs(x: i32): i32 {
        if x < 0 { return 0 - x }
        return x
    }

    public static min(a: i32, b: i32): i32 {
        if a < b { return a }
        return b
    }

    public static max(a: i32, b: i32): i32 {
        if a > b { return a }
        return b
    }

    public static clamp(value: i32, lo: i32, hi: i32): i32 = Math.min(Math.max(value, lo), hi)

    public static sign(x: i32): i32 {
        if x < 0 { return 0 - 1 }
        if x > 0 { return 1 }
        return 0
    }

    public static pow(base: i32, exp: usize): i32 {
        var result = 1
        var n: usize = 0
        while n < exp {
            result = result * base
            n = n + cast<usize>(1)
        }
        return result
    }

    public static gcd(a: i32, b: i32): i32 {
        var x = Math.abs(a)
        var y = Math.abs(b)
        while y != 0 {
            val t = x % y
            x = y
            y = t
        }
        return x
    }

    public static lcm(a: i32, b: i32): i32 {
        if a == 0 { return 0 }
        if b == 0 { return 0 }
        return Math.abs(a / Math.gcd(a, b) * b)
    }

    // Largest r with r * r <= n.
    public static isqrt(n: usize): usize {
        var r: usize = 0
        while (r + cast<usize>(1)) * (r + cast<usize>(1)) <= n {
            r = r + cast<usize>(1)
        }
        return r
    }
}
