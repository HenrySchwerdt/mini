package examples.net

import mini.concurrent.Thread
import mini.net.TcpConnection
import mini.net.TcpListener
import mini.net.NetError
import mini.net.NetErrorKind

class Main {
    static serve(listener: *TcpListener): void {
        match listener.accept() {
            Ok(connection) => Main.reply(&connection)
            Err(error) => print_i32(-1)
        }
    }

    static reply(connection: *TcpConnection): void {
        var request: u8 = 0
        val got = connection.read(&request, 1)
        val ok = match got { Ok(count) => count == cast<usize>(1), Err(error) => false }
        if ok {
            var answer: u8 = 42
            connection.write(&answer, 1)
        }
        connection.close()
    }

    static connectWithRetry(port: i32): Result<TcpConnection, NetError> {
        var attempt = 0
        while attempt < 100 {
            val result = TcpConnection.connectLoopback(port)
            val refused = match result { Ok(c) => false, Err(error) => error.kind == NetErrorKind.Refused }
            if !refused { return result }
            Thread.sleep(10)
            attempt = attempt + 1
        }
        return TcpConnection.connectLoopback(port)
    }

    static exchange(connection: *TcpConnection): i32 {
        var request: u8 = 1
        val wrote = match connection.write(&request, 1) { Ok(count) => count == cast<usize>(1), Err(error) => false }
        if !wrote { return 20 }
        var reply: u8 = 0
        val read = match connection.read(&reply, 1) { Ok(count) => count == cast<usize>(1), Err(error) => false }
        connection.close()
        if !read { return 21 }
        if reply != cast<u8>(42) { return 22 }
        return 0
    }

    static client(port: i32): i32 {
        return match Main.connectWithRetry(port) {
            Ok(connection) => Main.exchange(&connection)
            Err(error) => 23
        }
    }

    static run(listener: *TcpListener): i32 {
        val worker = Thread.create({ Main.serve(listener) })
        if match worker.start() { Ok(c) => false, Err(e) => true } { return 24 }
        val status = Main.client(34567)
        worker.close()
        return status
    }

    static main(): i32 {
        val status = match TcpListener.bind(34567) {
            Ok(listener) => Main.run(&listener)
            Err(error) => 25
        }
        if status != 0 { return status }
        print_i32(42)
        return 0
    }
}
