annotation class Since { val version: i32 }

@Since(2)
class Counter {
    private val value: i32

    static create(): Counter = Counter { value: 42 }

    @Deprecated("Use current instead")
    old(): i32 = this.value

    current(): i32 = this.value
}

class Main {
    static main(): i32 {
        val counter = Counter.create()
        print_i32(counter.current())
        return 0
    }
}
