package examples.pairs

import mini.core.Pair
import mini.core.Triple

class Main {
    static main(): i32 {
        val pair = Pair<i32, i32>.of(40, 2)
        val triple = Triple<i32, i32, i32>.of(1, 2, 3)
        if triple.third != 3 { return 1 }
        print_i32(pair.first + pair.second)
        return 0
    }
}
