package examples.lambdas

import mini.core.Functions

class CallbackHolder {
    public val callback: (i32) -> i32
}

class Main {
    static adder(offset: i32): (i32) -> i32 = { value -> value + offset }

    static transform<T>(value: T, action: (T) -> T): T = action(value)

    static main(): i32 {
        // The captured offset survives the adder call as an inline value.
        val addOne = Main.adder(1)
        if addOne(41) != 42 { return 1 }
        val holder = CallbackHolder { callback: { value -> value + 1 } }
        if holder.callback(41) != 42 { return 2 }
        if Main.transform<i32>(41, { it + 1 }) != 42 { return 3 }

        val nested: (i32) -> (i32) -> i32 = { first -> { second -> first + second } }
        if nested(40)(2) != 42 { return 4 }

        val choice: (i32) -> i32 = match true {
            true => { value -> value + 2 }
            false => { value -> value - 2 }
        }
        if choice(40) != 42 { return 5 }

        var replaceable: (i32) -> i32 = { it + 1 }
        replaceable = { it + 2 }
        if replaceable(40) != 42 { return 6 }

        // The pointer is borrowed; this example keeps its pointee alive.
        var total: usize = 0
        val output = &total
        Functions.repeat(7) { index -> *output = *output + index }
        if total != cast<usize>(21) { return 7 }
        val answer = Functions.run<i32>({ 42 })
        print_i32(answer)
        return 0
    }
}
