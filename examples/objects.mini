package examples.objects

import mini.memory.Allocator
import mini.memory.AllocationError

class CountingAllocator : Allocator {
    public var fail: bool
    public var allocations: i32
    public var releases: i32

    public override allocate(bytes: usize): Result<*u8, AllocationError> {
        if this.fail { return Result.Err(AllocationError.OutOfMemory) }
        return match heap.alloc(bytes) {
            Some(memory) => this.allocated(memory)
            None => Result.Err(AllocationError.OutOfMemory)
        }
    }

    private allocated(memory: *u8): Result<*u8, AllocationError> {
        this.allocations = this.allocations + 1
        return Result.Ok(memory)
    }

    public override release(memory: *u8): void {
        this.releases = this.releases + 1
        heap.free(memory)
    }
}

open class Counter : AllocatableObject {
    public var value: i32
    public open answer(): i32 = this.value
    public increment(): void { this.value = this.value + 1 }
}

class SpecialCounter : Counter {
    public val bonus: i32
    public override answer(): i32 = this.value + this.bonus
}

class Main {
    static answer(value: *Counter): i32 = value.answer()

    static main(): i32 {
        val stack = Counter { value: 40 }
        stack.increment()
        if stack.answer() != 41 { return 1 }
        val counter = SpecialCounter.allocate(SpecialCounter { value: 40, bonus: 2 })
        val okay = match counter {
            Ok(value) => Main.checkHeap(value)
            Err(error) => false
        }
        if !okay { return 2 }

        val allocator = CountingAllocator { fail: false, allocations: 0, releases: 0 }
        val custom = Counter.allocate(Counter { value: 41 }, &allocator)
        val customOkay = match custom {
            Ok(value) => Main.checkCustom(value, &allocator)
            Err(error) => false
        }
        if !customOkay { return 3 }
        if allocator.allocations != 1 || allocator.releases != 1 { return 4 }
        allocator.fail = true
        val failed = Counter.allocate(Counter { value: 0 }, &allocator)
        val sawError = match failed {
            Ok(value) => Main.unexpected(value, &allocator)
            Err(error) => error == AllocationError.OutOfMemory
        }
        if !sawError { return 5 }
        if allocator.allocations != 1 || allocator.releases != 1 { return 6 }
        print_i32(42)
        return 0
    }

    static checkHeap(value: *SpecialCounter): bool {
        val answer = Main.answer(value)
        SpecialCounter.free(value)
        return answer == 42
    }

    static checkCustom(value: *Counter, allocator: *Allocator): bool {
        value.increment()
        val answer = value.answer()
        Counter.free(value, allocator)
        return answer == 42
    }

    static unexpected(value: *Counter, allocator: *Allocator): bool {
        Counter.free(value, allocator)
        return false
    }
}
