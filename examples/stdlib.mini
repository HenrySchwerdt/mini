package examples.app

import mini.collections.Cell
import mini.core.Core
import mini.memory.HeapAllocator
import mini.io.Console

class Main {
    static main(): i32 {
        val cell = Cell<i32> { value: 21 }
        cell.set(Core.identity<i32>(42))
        val allocator = HeapAllocator {}
        val allocation = allocator.allocate(sizeof(i32))
        return match allocation {
            Ok(memory) => Main.useMemory(memory, &allocator, cell.get())
            Err(error) => 1
        }
    }

    static useMemory(raw: *u8, allocator: *HeapAllocator, value: i32): i32 {
        val number = cast<*i32>(raw)
        *number = value
        Console.print(*number)
        allocator.release(raw)
        return 0
    }
}
