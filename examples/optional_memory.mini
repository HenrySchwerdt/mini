class Main {
    static main(): i32 {
        val empty = heap.alloc(0)
        val absent = match empty {
            Some(memory) => Main.unexpected(memory)
            None => true
        }
        if !absent { return 1 }
        return match heap.alloc(8) {
            Some(memory) => Main.resize(memory)
            None => 2
        }
    }

    static unexpected(memory: *u8): bool {
        heap.free(memory)
        return false
    }

    static resize(memory: *u8): i32 {
        memory[0] = 42
        val refused = heap.realloc(memory, 0)
        val preserved = match refused {
            Some(replacement) => Main.unexpected(replacement)
            None => true
        }
        if !preserved { return 3 }
        if memory[0] != cast<u8>(42) { heap.free(memory); return 4 }
        return match heap.realloc(memory, 16) {
            Some(replacement) => Main.finish(replacement)
            None => Main.failed(memory)
        }
    }

    static failed(memory: *u8): i32 {
        heap.free(memory)
        return 5
    }

    static finish(memory: *u8): i32 {
        val okay = memory[0] == cast<u8>(42)
        heap.free(memory)
        if !okay { return 6 }
        print_i32(42)
        return 0
    }
}
