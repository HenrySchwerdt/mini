package examples.threads

import mini.concurrent.Thread
import mini.concurrent.Threads
import mini.concurrent.Mutex
import mini.concurrent.ConcurrencyError
import mini.concurrent.ConcurrencyErrorKind

class Main {
    static success(result: Result<bool, ConcurrencyError>): bool = match result {
        Ok(changed) => true
        Err(error) => false
    }

    static work(counter: *i32, guard: *Mutex): void {
        var index = 0
        while index < 10000 {
            val changed = guard.withLock() { *counter = *counter + 1 }
            if !Main.success(changed) { return }
            index = index + 1
        }
    }

    static workers(guard: *Mutex): i32 {
        var total = 0
        val counter = &total
        if !Main.success(guard.lock()) { guard.close(); return 1 }
        val first = Thread.create({ Main.work(counter, guard) })
        val second = Thread.create({ Main.work(counter, guard) })
        if !Main.success(first.start()) {
            guard.unlock(); first.close(); second.close(); guard.close(); return 2
        }
        if !Main.success(second.start()) {
            guard.unlock(); first.close(); second.close(); guard.close(); return 3
        }
        // Both workers are alive and blocked on our mutex. A synchronous callback
        // implementation would deadlock before reaching this point.
        val bothAlive = first.isAlive() && second.isAlive()
        guard.unlock()
        val firstJoined = Main.success(first.join())
        val secondJoined = Main.success(second.join())
        val joinedTwice = match first.join() { Ok(changed) => !changed, Err(error) => false }
        val restartRejected = match first.start() {
            Ok(changed) => false
            Err(error) => error.kind == ConcurrencyErrorKind.AlreadyStarted
        }
        val stopped = !first.isAlive() && !second.isAlive()
        first.close()
        second.close()
        if !bothAlive || !firstJoined || !secondJoined || !joinedTwice || !restartRejected || !stopped {
            guard.close(); return 4
        }
        if total != 20000 { guard.close(); return 5 }
        // Consistent non-recursive semantics, including on Windows.
        val locked = guard.tryLock()
        if !(match locked { Ok(acquired) => acquired, Err(error) => false }) { guard.close(); return 6 }
        val recursive = guard.tryLock()
        val busy = match recursive { Ok(acquired) => !acquired, Err(error) => false }
        val heldClose = match guard.close() {
            Ok(changed) => false
            Err(error) => error.kind == ConcurrencyErrorKind.Busy
        }
        guard.unlock()
        val closed = Main.success(guard.close())
        val closedTwice = match guard.close() { Ok(changed) => !changed, Err(error) => false }
        val rejected = match guard.lock() {
            Ok(changed) => false
            Err(error) => error.kind == ConcurrencyErrorKind.Closed
        }
        if !busy || !heldClose || !closed || !closedTwice || !rejected { return 7 }
        return 0
    }

    static finish(thread: *Thread, output: *i32): i32 {
        // close joins and releases the runtime context, including copied captures.
        if !Main.success(thread.close()) { return 8 }
        if *output != 42 { return 9 }
        val closed = match thread.start() {
            Ok(changed) => false
            Err(error) => error.kind == ConcurrencyErrorKind.Closed
        }
        if !closed { return 10 }
        return 0
    }

    static helper(): i32 {
        var value = 0
        val output = &value
        val started = Threads.thread() { Thread.sleep(2); *output = 42 }
        return match started {
            Ok(thread) => Main.finish(&thread, output)
            Err(error) => 11
        }
    }

    static main(): i32 {
        val newThread = Thread.create({ print_i32(-1) })
        val notStarted = match newThread.join() {
            Ok(changed) => false
            Err(error) => error.kind == ConcurrencyErrorKind.NotStarted
        }
        if !notStarted { newThread.close(); return 12 }
        if !Main.success(newThread.close()) { return 13 }
        val result = match Mutex.create() {
            Ok(guard) => Main.workers(&guard)
            Err(error) => 14
        }
        if result != 0 { return result }
        val helper = Main.helper()
        if helper != 0 { return helper }
        print_i32(42)
        return 0
    }
}
