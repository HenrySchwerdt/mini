#!/usr/bin/env bash
# Runs the Kotlin/Mini compiler driver from a source checkout (native, no JVM, no Gradle); builds the toolchain first if needed
# (like ./mini: from a native compiler found on this machine or the latest release).
#   ./minic build examples/hello.kt -o build/hello
#   ./minic check examples/memory_leak.kt
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root="$(cd "$(dirname "$src")" && pwd)"
"$root/mini" --version >/dev/null
exec "$root/build/native/bin/minic" "$@"
